TELEGRAM_BOT_TOKEN=token_dari_BotFather

# --- OTP otomatis (otp_listener.py): utamakan api_id + api_hash di accounts.json ---
# Multi akun (10 akun): gunakan login_all.py + otp_listener_multi.py dengan key otp_accounts di accounts.json
# Cadangan bila tidak ada di JSON:
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash
# File sesi Telethon (jangan dibagikan). Default: telethon_otp.session di folder proyek
# TELETHON_SESSION_PATH=telethon_otp.session
# Peer pengirim pesan "Login code" (biasanya 777000). Pisahkan koma bila perlu
# TELEGRAM_OTP_PEER_IDS=777000
# Production — notifikasi sistem → forum topic System Status:
# TELEGRAM_LOGIN_STATUS_CHAT_ID=-1003994531684
# TELEGRAM_LOGIN_STATUS_THREAD_ID=1322
# Development — preview ke DM dulu (comment baris production di atas jika pakai ini):
# TELEGRAM_STATUS_PREVIEW_CHAT_ID=7012261869
# TELEGRAM_STATUS_PREVIEW_ONLY=1
# (opsional) accounts.json → forum.topics.SYSTEM.thread_id sebagai fallback thread
# Kalau kosong, pakai notify_account / notify_chat_id dari otp_accounts (bisa salah kalau itu grup).
# Template pesan OTP: {profile} {account} {code} {password} (nilai {code}/{password} otomatis bold HTML)
# TELEGRAM_OTP_MASK_2FA=1  -> tampilkan titik-titik alih-alih password asli
# Pesan kedua hanya jika TELEGRAM_OTP_SEND_COPY_LINE=1 (default 0 = satu pesan saja)
# TELEGRAM_OTP_SEND_COPY_LINE=1
# TELEGRAM_OTP_COPY_LINE_TEMPLATE={code}
# TELEGRAM_OTP_MESSAGE_TEMPLATE=...
# Kirim OTP ke semua chat_id di accounts.json (setara --all)
# TELEGRAM_OTP_BROADCAST=0

# Multi akun OTP: atur PER BARIS di accounts.json -> otp_accounts[] (bukan hanya .env):
#   - "notify_chat_id": "1234567890"  -> kirim OTP ke chat itu langsung, atau
#   - "notify_account": "id_dari_accounts" -> harus sama persis dengan salah satu accounts[].id
# Satu baris otp_accounts = satu user Telegram + satu tujuan notifikasi (bisa beda tiap akun).
#
# TELEGRAM_ACCOUNT: fallback global untuk resolve chat (mis. `notify` tanpa -a), setelah last_chat jika PREFER_LAST=1.
# Isi dengan id yang sama dengan default_account di JSON agar konsisten, atau kosongkan untuk hanya pakai JSON.
# TELEGRAM_ACCOUNT=geri_work

# Opsional: path ke file JSON jika tidak di folder skrip
# TELEGRAM_ACCOUNTS_FILE=D:\path\ke\accounts.json

# 0 = jangan isi accounts.json otomatis saat user /start
# TELEGRAM_AUTO_REGISTER=0

# Bot daftar chat-only: lihat folder telegram_account_register\ (.env.example di sana).

# 0 = jangan utamakan chat terakhir; pakai default_account / TELEGRAM_ACCOUNT dulu
# TELEGRAM_PREFER_LAST_CHAT=0

# /accounts: 1 = hanya chat privat (nomor tidak di grup). Default 0 = boleh di grup (sama seperti /login)
# TELEGRAM_ACCOUNTS_CMD_PRIVATE_ONLY=1

# --- Stabilitas jaringan / API (opsional) ---
# Retry kirim pesan ke api.telegram.org (default 3) dan timeout detik (min 5)
# TELEGRAM_HTTP_RETRIES=5
# TELEGRAM_HTTP_TIMEOUT_SEC=45
# Retry koneksi Telethon (listen / login-all)
# TELETHON_CONNECTION_RETRIES=8
# TELETHON_REQUEST_RETRIES=5

# --- Putus koneksi singkat (WiFi mati sebentar) — hindari spam "Session Disconnected" ---
# Tunggu N detik sebelum coba reconnect (default 90)
# TELEGRAM_DISCONNECT_GRACE_SEC=90
# Jumlah percobaan reconnect + jeda antar percobaan (detik)
# TELEGRAM_DISCONNECT_RECONNECT_ATTEMPTS=5
# TELEGRAM_DISCONNECT_RECONNECT_DELAY_SEC=15
# Jangan kirim alert Telegram yang sama untuk akun yang sama dalam N detik (default 900 = 15 menit)
# TELEGRAM_DISCONNECT_ALERT_COOLDOWN_SEC=900
# Jika ≥ N akun putus bersamaan, kirim 1 pesan ringkasan (bukan satu per akun)
# TELEGRAM_DISCONNECT_BATCH_MIN=3
# TELEGRAM_DISCONNECT_BATCH_WINDOW_SEC=45
# Matikan notifikasi disconnect ke Telegram (tetap log di terminal): TELEGRAM_DISCONNECT_ALERT=0

# --- Lock JSON antar-proses (bot + listen) & deteksi OTP cerdas ---
# TELEGRAM_JSON_LOCK_TIMEOUT_SEC=25
# Retry saat file .session Telethon locked saat login-all (default 12)
# TELEGRAM_LOGIN_SQLITE_RETRIES=12
# Panjang kode OTP (pisah koma), contoh: 5 atau 5,6
# TELEGRAM_OTP_CODE_LENGTHS=5
# Proximity keyword tanpa loose penuh (0=mati)
# TELEGRAM_OTP_SMART_DETECT=1
# Cegah kirim ulang OTP sama dalam N detik (0=mati)
# TELEGRAM_OTP_DEDUP_SEC=25
# Fuzzy match id setelah /login (default mati = lebih aman). Aktifkan hanya jika perlu toleransi typo:
# TELEGRAM_FUZZY_ID_MATCH=1
# Ambang kemiripan 0.3–1.0 (difflib), hanya dipakai jika fuzzy diaktifkan
# TELEGRAM_FUZZY_ID_CUTOFF=0.82

# --- Google Sheets (command `sync`) ---
# ID dari URL: https://docs.google.com/spreadsheets/d/1quTwrSqrdaJfIeMct7bABa_cNajx5H6pPyAHNz79L8o/edit
# GOOGLE_SHEET_ID=1quTwrSqrdaJfIeMct7bABa_cNajx5H6pPyAHNz79L8o
# GOOGLE_SHEETS_CREDENTIALS=tg-otp-automation-71a6e40268eb.json
# GOOGLE_SHEET_TAB_TELEGRAM=Telegram Acc
# GOOGLE_SHEET_USE_TELEGRAM_ACC=1
# Share Sheet ke: telegram-automation-otp-code@tg-otp-automation.iam.gserviceaccount.com (Editor)
# Health-check saat sync (deteksi banned/frozen). Mati: TELEGRAM_SYNC_HEALTH_CHECK=0
# TELEGRAM_SYNC_HEALTH_CHECK=1
# Interval sync daemon idle (detik). Default 600 = 10 menit
# TELEGRAM_SYNC_INTERVAL_SEC=600
# Live pull (hanya Sheet -> JSON auto-register), default 45 detik
# TELEGRAM_SYNC_PULL_INTERVAL_SEC=45
# Live status (health+push Account Status/Session Friday), default 120 detik
# TELEGRAM_SYNC_STATUS_INTERVAL_SEC=120
# Update Sheet segera saat listen deteksi banned/frozen/disconnected (default on)
# TELEGRAM_SYNC_INSTANT_PUSH=1
