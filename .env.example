# Copy to .env and fill in secrets. Do NOT commit .env

TELEGRAM_BOT_TOKEN=your_token_from_BotFather
TELEGRAM_ACCOUNT=geri_work

# Production — system notifications → forum topic System Status
TELEGRAM_LOGIN_STATUS_CHAT_ID=-1003994531684
TELEGRAM_LOGIN_STATUS_THREAD_ID=1322

# Development preview (comment out in production)
# TELEGRAM_STATUS_PREVIEW_CHAT_ID=7012261869
# TELEGRAM_STATUS_PREVIEW_ONLY=1

# --- OTP listener ---
TELEGRAM_OTP_PEER_IDS=777000
TELEGRAM_LISTEN_SHOOTER=1
TELEGRAM_SYNC_PROFILE_ON_LISTEN=1
# Frozen detection — health-check only (never LISTEN mass-scan).
TELEGRAM_FROZEN_SPAMBOT_PROBE=1
TELEGRAM_FROZEN_UI_PROBE=1
TELEGRAM_FROZEN_UI_PROBE_TEXT=.
TELEGRAM_SPAMBOT_PROBE_TIMEOUT_SEC=6
TELEGRAM_SPAMBOT_FROZEN_CHECK=0
TELEGRAM_NOTIFY_FROZEN=1
TELEGRAM_NOTIFY_FROZEN_COOLDOWN_SEC=86400
TELEGRAM_REQUIRE_LOGIN_REQUEST=1
# Alert ke System Status saat login sukses tanpa /login (1 notif, full session details)
TELEGRAM_MANUAL_LOGIN_ALERT=1
TELEGRAM_MANUAL_LOGIN_ALERT_COOLDOWN_SEC=300
TELEGRAM_MANUAL_LOGIN_FOLLOWUP_SEC=60
TELEGRAM_LISTEN_HOT_RELOAD=1
TELEGRAM_LISTEN_RELOAD_INTERVAL_SEC=45
TELEGRAM_LISTEN_FAILED_RETRY_SEC=300
TELEGRAM_LISTEN_STOP_NOTIFY=1

# --- Network / API stability ---
TELEGRAM_HTTP_RETRIES=5
TELEGRAM_HTTP_TIMEOUT_SEC=45
TELETHON_CONNECTION_RETRIES=8
TELETHON_REQUEST_RETRIES=5
TELEGRAM_JSON_LOCK_TIMEOUT_SEC=25
TELEGRAM_LOGIN_SQLITE_RETRIES=12

# --- Brief disconnects ---
TELEGRAM_DISCONNECT_GRACE_SEC=90
TELEGRAM_DISCONNECT_RECONNECT_ATTEMPTS=5
TELEGRAM_DISCONNECT_RECONNECT_DELAY_SEC=15
TELEGRAM_DISCONNECT_ALERT_COOLDOWN_SEC=900
TELEGRAM_DISCONNECT_BATCH_MIN=3
TELEGRAM_DISCONNECT_BATCH_WINDOW_SEC=45
TELEGRAM_DISCONNECT_ALERT=1

# --- OTP detection ---
TELEGRAM_OTP_SMART_DETECT=1
TELEGRAM_OTP_DEDUP_SEC=25
TELEGRAM_OTP_CODE_LENGTHS=5
TELEGRAM_FUZZY_ID_MATCH=1
TELEGRAM_FUZZY_ID_CUTOFF=0.82

# --- Google Sheets ---
GOOGLE_SHEET_ID=your_sheet_id_from_url
GOOGLE_SHEETS_CREDENTIALS=tg-otp-automation-71a6e40268eb.json
GOOGLE_SHEET_TAB_TELEGRAM=Telegram Acc
GOOGLE_SHEET_USE_TELEGRAM_ACC=1

# Sheet tab "Telegram Acc" columns:
#   Device ID, Group (Main/Other), Acc Name, Phone, Status, Session Friday, 2FA, OTP
# Staff sets Status=Pending → LIVE-LOGIN. Script writes Ready/Banned/Frozen/Disconnected.

TELEGRAM_SHEET_LOGIN_TRIGGER_STATUS=Pending
TELEGRAM_SHEET_STATUS_AFTER_LOGIN=Ready

TELEGRAM_SYNC_HEALTH_CHECK=1
TELEGRAM_SYNC_INSTANT_PUSH=1
TELEGRAM_PURGE_BANNED_ACCOUNTS=1
# Hapus akun Frozen dari JSON + session (restricted / SpamBot violation block / UI probe)
TELEGRAM_PURGE_FROZEN_ACCOUNTS=1

# LIVE-PULL: only Pending + new phone → JSON (never rewrite existing rows)
TELEGRAM_SYNC_PULL_PENDING_ONLY=1
# Full pull: rename SH_OLD_* → SH_NEW_* when Sheet User/owner changes (moves session file)
TELEGRAM_SYNC_SHOOTER_RENAME_ON_OWNER=1
TELEGRAM_SYNC_PULL_INTERVAL_SEC=120
TELEGRAM_SHEET_READ_CACHE_SEC=20

# LIVE-LOGIN: SMS once → wait for 5-digit OTP in Sheet (quiet poll, no spam)
TELEGRAM_LOGIN_SHEET_CODE=1
TELEGRAM_SHEET_LOGIN_WAIT_SEC=180
TELEGRAM_SHEET_LOGIN_POLL_SEC=2
TELEGRAM_LOGIN_OTP_RETRIES=3
TELEGRAM_LOGIN_SHEET_FALLBACK_TTY=0
TELEGRAM_SYNC_LOGIN_INTERVAL_SEC=60
TELEGRAM_SYNC_LOGIN_FAST_INTERVAL_SEC=5
TELEGRAM_LIVE_LOGIN_WAIT_LOG_SEC=90
TELEGRAM_LIVE_LOGIN_IDLE_LOG_SEC=300
TELEGRAM_LIVE_LOGIN_SKIP_PULL=1
TELEGRAM_LIVE_LOGIN_NOTIFY=1
TELEGRAM_SHEET_CLEAR_CODE_AFTER_LOGIN=1

# LIVE-STATUS: delta push + scheduled health-check (172800 = 2 days; 0 = off)
TELEGRAM_SYNC_STATUS_INTERVAL_SEC=300
TELEGRAM_SYNC_HEALTH_INTERVAL_SEC=172800

# Status queue: compact after push (max lines kept on disk)
TELEGRAM_STATUS_QUEUE_MAX_LINES=2000

GOOGLE_SHEET_READ_RETRIES=4
GOOGLE_SHEET_BATCH_SIZE=40
GOOGLE_SHEET_BATCH_PAUSE_SEC=0.25
GOOGLE_SHEET_BATCH_RETRIES=4
GOOGLE_SHEET_BATCH_BASE_SLEEP_SEC=1.0

# Share Sheet with (Editor):
# telegram-automation-otp-code@tg-otp-automation.iam.gserviceaccount.com
