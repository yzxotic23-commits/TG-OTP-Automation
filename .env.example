# Copy to .env and fill in secrets. Do NOT commit .env

TELEGRAM_BOT_TOKEN=your_token_from_BotFather
TELEGRAM_ACCOUNT=geri_work

# Production — system notifications → forum topic System Status
TELEGRAM_LOGIN_STATUS_CHAT_ID=-1003994531684
TELEGRAM_LOGIN_STATUS_THREAD_ID=1322

# Development preview (comment out in production)
# TELEGRAM_STATUS_PREVIEW_CHAT_ID=7012261869
# TELEGRAM_STATUS_PREVIEW_ONLY=1

# --- OTP listener ---
TELEGRAM_OTP_PEER_IDS=777000
TELEGRAM_LISTEN_SHOOTER=1
TELEGRAM_SYNC_PROFILE_ON_LISTEN=1
# Frozen detection — health-check only (never LISTEN mass-scan).
TELEGRAM_FROZEN_SPAMBOT_PROBE=1
TELEGRAM_FROZEN_UI_PROBE=1
TELEGRAM_FROZEN_UI_PROBE_TEXT=.
TELEGRAM_SPAMBOT_PROBE_TIMEOUT_SEC=6
TELEGRAM_SPAMBOT_FROZEN_CHECK=0
TELEGRAM_NOTIFY_FROZEN=1
TELEGRAM_NOTIFY_FROZEN_COOLDOWN_SEC=86400
TELEGRAM_NOTIFY_EXPIRED=1
TELEGRAM_NOTIFY_EXPIRED_COOLDOWN_SEC=86400
TELEGRAM_REQUIRE_LOGIN_REQUEST=1
# Berapa lama /login aktif sebelum OTP ditolak (detik). Staff harus trigger device dalam window ini.
TELEGRAM_LOGIN_REQUEST_TTL_SEC=300
# Alert ke System Status saat login sukses tanpa /login (1 notif, full session details)
TELEGRAM_MANUAL_LOGIN_ALERT=1
TELEGRAM_MANUAL_LOGIN_ALERT_COOLDOWN_SEC=300
TELEGRAM_MANUAL_LOGIN_FOLLOWUP_SEC=60
# Manual-login CC default: @geri_work @Sinyee_29 @Zaabryan (/add admin does NOT auto-tag)
# TELEGRAM_MANUAL_LOGIN_CC=geri_work,sinyee,zaabryan
# TELEGRAM_MANUAL_LOGIN_CC_EXTRA=someone_else
# Mac LISTEN (~170 sessions): butuh fd limit tinggi — start_production_mac.sh sudah set ulimit -n 10240
# TELEGRAM_LISTEN_MIN_FD=8192
# Log terminal LIVE-PULL / LIVE-LOGIN / LIVE-STATUS pakai WIB (default Asia/Jakarta)
TELEGRAM_LOG_TIMEZONE=Asia/Jakarta

TELEGRAM_LISTEN_HOT_RELOAD=1
TELEGRAM_LISTEN_RELOAD_INTERVAL_SEC=45
TELEGRAM_LISTEN_FAILED_RETRY_SEC=300
TELEGRAM_LISTEN_STOP_NOTIFY=1
# LISTEN ~170 sessions: entity cache OFF = less SQLite disk I/O (Mac). Set 1 only if needed.
TELEGRAM_LISTEN_SAVE_ENTITIES=0
# 1000 recommended with TELEGRAM_SYNC_PROFILE_ON_LISTEN=1 (200 causes flush storms)
TELEGRAM_LISTEN_ENTITY_CACHE_LIMIT=1000
TELEGRAM_LISTEN_SQLITE_TIMEOUT_SEC=30

# --- Network / API stability ---
TELEGRAM_HTTP_RETRIES=5
TELEGRAM_HTTP_TIMEOUT_SEC=45
TELETHON_CONNECTION_RETRIES=8
TELETHON_REQUEST_RETRIES=5
TELEGRAM_JSON_LOCK_TIMEOUT_SEC=25
TELEGRAM_LOGIN_SQLITE_RETRIES=12
# Login writes session to /tmp first, then moves — avoids disk I/O clash with LISTEN
TELEGRAM_LOGIN_USE_TEMP_SESSION=1

# --- Brief disconnects (network blip ≠ Expired) ---
# Grace = tunggu berapa detik sebelum alert staff — reconnect langsung tanpa delay ini.
TELEGRAM_DISCONNECT_GRACE_SEC=90
TELEGRAM_DISCONNECT_RECONNECT_ATTEMPTS=8
TELEGRAM_DISCONNECT_RECONNECT_DELAY_SEC=3
TELEGRAM_DISCONNECT_RECONNECT_MAX_DELAY_SEC=45
TELEGRAM_DISCONNECT_STAGGER_MS=2500
TELEGRAM_DISCONNECT_ALERT_COOLDOWN_SEC=900
TELEGRAM_DISCONNECT_BATCH_MIN=3
TELEGRAM_DISCONNECT_BATCH_WINDOW_SEC=45
TELEGRAM_DISCONNECT_ALERT=1
# Hot-reload: cooldown setelah network glitch (bukan session mati)
TELEGRAM_LISTEN_NETWORK_RETRY_SEC=90

# --- OTP detection ---
TELEGRAM_OTP_SMART_DETECT=1
TELEGRAM_OTP_DEDUP_SEC=25
TELEGRAM_OTP_CODE_LENGTHS=5
TELEGRAM_FUZZY_ID_MATCH=1
TELEGRAM_FUZZY_ID_CUTOFF=0.82

# --- Google Sheets ---
GOOGLE_SHEET_ID=your_sheet_id_from_url
GOOGLE_SHEETS_CREDENTIALS=tg-otp-automation-71a6e40268eb.json
GOOGLE_SHEET_TAB_TELEGRAM=Telegram Acc
GOOGLE_SHEET_USE_TELEGRAM_ACC=1

# Sheet tab "Telegram Acc" columns:
#   Device ID, Group (Main/Other), Acc Name, Phone, Status, Session Friday, 2FA, OTP
# Staff sets Status=Pending → LIVE-LOGIN. Script writes Ready/Banned/Frozen/Disconnected.
# Session Friday = script only (Active / Pending Login / …) — BUKAN trigger login.

TELEGRAM_SHEET_LOGIN_TRIGGER_STATUS=Pending
TELEGRAM_SHEET_STATUS_AFTER_LOGIN=Ready

TELEGRAM_SYNC_HEALTH_CHECK=1
TELEGRAM_SYNC_INSTANT_PUSH=1
TELEGRAM_PURGE_BANNED_ACCOUNTS=1
# Hapus akun Frozen dari JSON + session (restricted / SpamBot violation block / UI probe)
TELEGRAM_PURGE_FROZEN_ACCOUNTS=1

# LIVE-PULL: only Pending + new phone → JSON for *new* GCS/shooter rows.
# Shooter existing rows: User/owner (+ SH_* rename) still syncs when Sheet User changes.
TELEGRAM_SYNC_PULL_PENDING_ONLY=1
# Rename SH_OLD_* → SH_NEW_* + move .session when Sheet User/owner changes (default ON).
# Only runs for phones whose owner actually changed (not a mass rename every pull).
TELEGRAM_SYNC_SHOOTER_RENAME_ON_OWNER=1
TELEGRAM_SYNC_PULL_INTERVAL_SEC=120
# Cache baca Sheet (LISTEN pending check / hot-reload) — kurangi hit Google API
TELEGRAM_SHEET_READ_CACHE_SEC=120
# /main & /other: 0 = filter dari JSON saja (cepat); 1 = baca Sheet juga (cache, jangan force)
TELEGRAM_BOT_LIST_LIVE_SHEET=0

# LIVE-LOGIN: OTP primary — wait for 5-digit OTP in Sheet (QR backup: TELEGRAM_BOT_QR_LOGIN / login-qr)
TELEGRAM_LOGIN_SHEET_CODE=1
# Device profile for send_code — mobile-like params improve OTP push (Telethon #4730)
TELEGRAM_LOGIN_DEVICE_MODEL=FRIDAY_BO
TELEGRAM_LOGIN_SYSTEM_VERSION=Android 13
TELEGRAM_LOGIN_APP_VERSION=10.14.5 (48959)
TELEGRAM_LOGIN_LANG_CODE=en
TELEGRAM_LOGIN_SYSTEM_LANG_CODE=en-US
# After SentCodeTypeApp, try ResendCodeRequest for alternate delivery (1=on)
TELEGRAM_LOGIN_RESEND_AFTER_APP=1
# Min seconds between SendCode to same phone (anti-spam / silent Telegram)
TELEGRAM_LOGIN_SEND_CODE_MIN_INTERVAL_SEC=120
# QR login via bot (/login qr) — admin only, kirim QR ke chat
TELEGRAM_BOT_QR_LOGIN=0
TELEGRAM_BOT_QR_LOGIN_ADMINS=geri_work
# LIVE-LOGIN daemon: QR scan (tanpa OTP Sheet)
TELEGRAM_LOGIN_USE_QR=0
TELEGRAM_SHEET_LOGIN_WAIT_SEC=180
# Poll interval — 3s recommended (1s + full sheet reads → Google 429)
TELEGRAM_SHEET_LOGIN_POLL_SEC=3
TELEGRAM_SHEET_LOGIN_READ_RETRIES=8
TELEGRAM_SHEET_LOGIN_READ_MAX_SLEEP_SEC=4
TELEGRAM_LOGIN_OTP_RETRIES=3
TELEGRAM_LOGIN_SHEET_FALLBACK_TTY=0
TELEGRAM_SYNC_LOGIN_INTERVAL_SEC=60
TELEGRAM_SYNC_LOGIN_FAST_INTERVAL_SEC=5
TELEGRAM_LIVE_LOGIN_WAIT_LOG_SEC=90
TELEGRAM_LIVE_LOGIN_IDLE_LOG_SEC=300
TELEGRAM_LIVE_LOGIN_SKIP_PULL=1
TELEGRAM_LIVE_LOGIN_NOTIFY=1
TELEGRAM_SHEET_CLEAR_CODE_AFTER_LOGIN=1
# Cooldown setelah login gagal sebelum retry (detik)
TELEGRAM_SHEET_LOGIN_FAIL_COOLDOWN_SEC=600

# LIVE-STATUS: delta push + scheduled health-check (43200 = 12h · 2 shifts/day; 0 = off)
# Code default 120s; naikkan jika ingin kurangi hit Google API
TELEGRAM_SYNC_STATUS_INTERVAL_SEC=120
TELEGRAM_SYNC_HEALTH_INTERVAL_SEC=43200

# Status queue: compact after push (max lines kept on disk)
TELEGRAM_STATUS_QUEUE_MAX_LINES=2000

GOOGLE_SHEET_READ_RETRIES=4
GOOGLE_SHEET_BATCH_SIZE=40
GOOGLE_SHEET_BATCH_PAUSE_SEC=0.25
GOOGLE_SHEET_BATCH_RETRIES=4
GOOGLE_SHEET_BATCH_BASE_SLEEP_SEC=1.0

# Share Sheet with (Editor):
# telegram-automation-otp-code@tg-otp-automation.iam.gserviceaccount.com
