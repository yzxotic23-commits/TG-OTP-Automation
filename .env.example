TELEGRAM_BOT_TOKEN=your_token_from_BotFather

# --- OTP listener: prefer api_id + api_hash in accounts.json ---
# Multi-account: use otp_accounts[] in accounts.json (see login-all / listen)
# Fallback if not in JSON:
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash
# Telethon session file (do not share). Default: telethon_otp.session in project folder
# TELETHON_SESSION_PATH=telethon_otp.session
# Sender peer for login codes (usually 777000). Comma-separated if needed
# TELEGRAM_OTP_PEER_IDS=777000
# Production — system notifications → forum topic System Status:
# TELEGRAM_LOGIN_STATUS_CHAT_ID=-1003994531684
# TELEGRAM_LOGIN_STATUS_THREAD_ID=1322
# Development — preview to DM first (comment production lines above when using this):
# TELEGRAM_STATUS_PREVIEW_CHAT_ID=7012261869
# TELEGRAM_STATUS_PREVIEW_ONLY=1
# (optional) accounts.json → forum.topics.SYSTEM.thread_id as fallback thread
# If empty, uses notify_account / notify_chat_id from otp_accounts (may be wrong if that is a group).
# OTP message template: {profile} {account} {code} {password} ({code}/{password} auto-bold in HTML)
# TELEGRAM_OTP_MASK_2FA=1  -> show dots instead of real 2FA password
# Second message only if TELEGRAM_OTP_SEND_COPY_LINE=1 (default 0 = single message)
# TELEGRAM_OTP_SEND_COPY_LINE=1
# TELEGRAM_OTP_COPY_LINE_TEMPLATE={code}
# TELEGRAM_OTP_MESSAGE_TEMPLATE=...
# Broadcast OTP to all chat_id in accounts.json (like --all)
# TELEGRAM_OTP_BROADCAST=0

# Multi-account OTP: configure PER ROW in accounts.json -> otp_accounts[] (not only .env):
#   - "notify_chat_id": "1234567890"  -> send OTP to that chat directly, or
#   - "notify_account": "id_from_accounts" -> must match exactly one accounts[].id
# One otp_accounts row = one Telegram user + one notification target (can differ per account).
#
# TELEGRAM_ACCOUNT: global fallback to resolve chat (e.g. `notify` without -a), after last_chat if PREFER_LAST=1.
# Set to the same id as default_account in JSON for consistency, or leave empty to use JSON only.
# TELEGRAM_ACCOUNT=geri_work

# Optional: path to JSON file if not in the script folder
# TELEGRAM_ACCOUNTS_FILE=D:\path\to\accounts.json

# 0 = do not auto-fill accounts.json when user sends /start
# TELEGRAM_AUTO_REGISTER=0

# Chat-only registration bot: see telegram_account_register\ (.env.example there).

# 0 = do not prefer last chat; use default_account / TELEGRAM_ACCOUNT first
# TELEGRAM_PREFER_LAST_CHAT=0

# /accounts: 1 = private chat only (phone not in groups). Default 0 = allowed in groups (like /login)
# TELEGRAM_ACCOUNTS_CMD_PRIVATE_ONLY=1

# --- Network / API stability (optional) ---
# Retry sending to api.telegram.org (default 3) and timeout seconds (min 5)
# TELEGRAM_HTTP_RETRIES=5
# TELEGRAM_HTTP_TIMEOUT_SEC=45
# Telethon connection retries (listen / login-all)
# TELETHON_CONNECTION_RETRIES=8
# TELETHON_REQUEST_RETRIES=5

# --- Brief disconnects (WiFi drop) — avoid spam "Session Disconnected" ---
# Wait N seconds before reconnect attempt (default 90)
# TELEGRAM_DISCONNECT_GRACE_SEC=90
# Reconnect attempts + delay between attempts (seconds)
# TELEGRAM_DISCONNECT_RECONNECT_ATTEMPTS=5
# TELEGRAM_DISCONNECT_RECONNECT_DELAY_SEC=15
# Do not repeat the same Telegram alert for the same account within N seconds (default 900 = 15 min)
# TELEGRAM_DISCONNECT_ALERT_COOLDOWN_SEC=900
# If >= N accounts disconnect together, send one summary (not one per account)
# TELEGRAM_DISCONNECT_BATCH_MIN=3
# TELEGRAM_DISCONNECT_BATCH_WINDOW_SEC=45
# Disable disconnect Telegram alerts (terminal log only): TELEGRAM_DISCONNECT_ALERT=0

# --- Cross-process JSON lock (bot + listen) & smart OTP detection ---
# TELEGRAM_JSON_LOCK_TIMEOUT_SEC=25
# Retry when Telethon .session SQLite is locked during login (default 12)
# TELEGRAM_LOGIN_SQLITE_RETRIES=12
# OTP code lengths (comma-separated), e.g. 5 or 5,6
# TELEGRAM_OTP_CODE_LENGTHS=5
# Proximity keyword detection without full loose mode (0=off)
# TELEGRAM_OTP_SMART_DETECT=1
# Prevent resending the same OTP within N seconds (0=off)
# TELEGRAM_OTP_DEDUP_SEC=25
# Fuzzy match id after /login (default off = safer). Enable only if typo tolerance is needed:
# TELEGRAM_FUZZY_ID_MATCH=1
# Similarity threshold 0.3–1.0 (difflib), only used when fuzzy is enabled
# TELEGRAM_FUZZY_ID_CUTOFF=0.82

# --- Google Sheets (command `sync`) ---
# ID from URL: https://docs.google.com/spreadsheets/d/1quTwrSqrdaJfIeMct7bABa_cNajx5H6pPyAHNz79L8o/edit
# GOOGLE_SHEET_ID=1quTwrSqrdaJfIeMct7bABa_cNajx5H6pPyAHNz79L8o
# GOOGLE_SHEETS_CREDENTIALS=tg-otp-automation-71a6e40268eb.json
# GOOGLE_SHEET_TAB_TELEGRAM=Telegram Acc
# GOOGLE_SHEET_USE_TELEGRAM_ACC=1
# Share Sheet with: telegram-automation-otp-code@tg-otp-automation.iam.gserviceaccount.com (Editor)
#
# Sheet columns (tab Telegram Acc):
#   I  Status          — set Pending to trigger LIVE-LOGIN
#   J  Account Status  — script writes Active / Banned / Frozen
#   K  Session Friday  — script writes Active / Disconnected
#   L  2FA             — cloud / 2FA password (header: 2FA)
#   M  OTP             — SMS login code (header: OTP)
#
# TELEGRAM_SHEET_LOGIN_TRIGGER_STATUS=Pending
# TELEGRAM_SHEET_STATUS_AFTER_LOGIN=Feeding
# Health-check on sync (detect banned/frozen). Off: TELEGRAM_SYNC_HEALTH_CHECK=0
# TELEGRAM_SYNC_HEALTH_CHECK=1
# Sync daemon idle interval (seconds). Default 600 = 10 minutes
# TELEGRAM_SYNC_INTERVAL_SEC=600
# Live pull (Sheet -> JSON auto-register only), default 45 seconds
# TELEGRAM_SYNC_PULL_INTERVAL_SEC=45
# Live login: Sheet OTP column -> Telethon session (no terminal typing)
# TELEGRAM_LOGIN_SHEET_CODE=1
# TELEGRAM_SHEET_LOGIN_WAIT_SEC=180
# TELEGRAM_SHEET_LOGIN_POLL_SEC=3
# TELEGRAM_SYNC_LOGIN_INTERVAL_SEC=60
# TELEGRAM_SYNC_LOGIN_FAST_INTERVAL_SEC=20
# TELEGRAM_LIVE_LOGIN_SKIP_PULL=1
# TELEGRAM_SHEET_CLEAR_CODE_AFTER_LOGIN=1
# Listen hot-reload: auto-add new accounts from JSON without restarting listen (default on)
# TELEGRAM_LISTEN_HOT_RELOAD=1
# TELEGRAM_LISTEN_RELOAD_INTERVAL_SEC=45
# Live status (push Account Status / Session Friday from queue), default 120 seconds
# TELEGRAM_SYNC_STATUS_INTERVAL_SEC=120
# Bulk update to Google Sheet (avoid 1-by-1 writes & reduce 429)
# GOOGLE_SHEET_BATCH_SIZE=40
# GOOGLE_SHEET_BATCH_PAUSE_SEC=0.25
# GOOGLE_SHEET_BATCH_RETRIES=4
# GOOGLE_SHEET_BATCH_BASE_SLEEP_SEC=1.0
# Instant Sheet update when listen detects banned/frozen/disconnected (default on)
# TELEGRAM_SYNC_INSTANT_PUSH=1
